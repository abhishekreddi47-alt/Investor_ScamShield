# Investor ScamShield - Environment Configuration Template
# Copy this file to .env for local overrides if needed.

# Flask secret key (optional; has safe default)
SECRET_KEY=scamshield-production-secret-key-change-in-prod

# Flask debug mode: 0 for production, 1 for local development
FLASK_DEBUG=0

# Server listening port (default: 5000)
PORT=5000

# Optional: Custom path to Tesseract OCR binary (if self-hosting or installing system binary)
# TESSERACT_PATH=/usr/bin/tesseract
